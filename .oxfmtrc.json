{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "semi": false,
  "trailingComma": "none",
  "proseWrap": "always",
  "sortImports": {
    "enabled": true,
    "newlinesBetween": false,
    "sortSpecifiers": true
  },
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/dist/**",
    "**/coverage/**",
    "**/node_modules/**",
    "pnpm-lock.yaml",
    "api-reports/*.api.md",
    "**/.generated/**"
  ]
}
