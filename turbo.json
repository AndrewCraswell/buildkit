{
  "$schema": "https://turborepo.dev/schema.json",
  "remoteCache": {
    "signature": true
  },
  "tasks": {
    "@buildkitgg/docs#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/api-reports/**",
        "$TURBO_ROOT$/packages/*/*/README.md",
        "$TURBO_ROOT$/packages/*/*/package.json",
        "$TURBO_ROOT$/packages/*/*/src/**",
        "$TURBO_ROOT$/apps/site/public/mark.svg"
      ],
      "outputs": ["dist/site/**"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build", "^transit"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "storybook-static/**"]
    },
    "build-storybook": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check:types": {
      "dependsOn": ["^check:types"]
    },
    "check:unused": {
      "dependsOn": ["^check:unused"]
    },
    "test": {
      "dependsOn": ["^transit"],
      "outputs": ["coverage/**"]
    },
    "test:coverage": {
      "dependsOn": ["^transit"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
