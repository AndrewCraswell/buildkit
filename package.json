{
  "name": "buildkit",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "verify": "run-s check:format check:lint check:types check:unused check:api test:coverage build",
    "check:api": "turbo run build --filter='./packages/**' && pnpm --filter @repo/api-tools api:check",
    "api:update": "turbo run build --filter='./packages/**' && pnpm --filter @repo/api-tools api:update",
    "format": "oxfmt",
    "check:format": "oxfmt --check",
    "check:lint": "turbo run lint",
    "check:types": "turbo run check:types",
    "check:unused": "knip",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "change": "beachball change",
    "check:change": "beachball check",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "beachball": "^2.65.5",
    "knip": "^6.16.1",
    "lefthook": "^2.1.9",
    "npm-run-all2": "^9.0.2",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "turbo": "^2.10.0"
  }
}
