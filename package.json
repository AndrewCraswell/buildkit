{
  "name": "buildkit",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "build": "vp run --cache --filter \"./packages/**\" --filter \"./apps/**\" build",
    "build:packages": "vp run --cache --filter \"./packages/**\" build",
    "dev": "vp run --parallel --filter \"./apps/**\" dev",
    "verify": "pnpm check && pnpm check:unused && pnpm check:api && pnpm test:coverage && pnpm build",
    "check": "pnpm build:packages && vp check",
    "check:api": "pnpm build:packages && pnpm --filter @repo/api-tools api:check",
    "api:update": "pnpm build:packages && pnpm --filter @repo/api-tools api:update",
    "format": "vp fmt",
    "check:unused": "knip",
    "test": "pnpm build:packages && vp run --cache --filter \"./packages/**\" --filter \"./apps/**\" test",
    "test:coverage": "pnpm build:packages && vp run --cache --filter \"./packages/**\" --filter \"./apps/**\" test:coverage",
    "change": "beachball change",
    "check:change": "beachball check",
    "prepare": "vp config --no-agent",
    "update:shadcn": "pnpm --filter @repo/shadcn-generator update:shadcn",
    "generate": "pnpm --filter @repo/shadcn-generator generate && pnpm install",
    "validate": "pnpm verify && pnpm --filter @repo/shadcn-generator validate"
  },
  "devDependencies": {
    "beachball": "^2.65.5",
    "knip": "^6.43.0",
    "vite-plus": "catalog:"
  }
}
