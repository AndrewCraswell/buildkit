{
  "name": "@buildkitgg/shadcn-baseui-kit",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tailwindcss -i src/styles.css -o dist/styles.css --minify && tailwindcss -i src/styles-no-reset.css -o dist/styles-no-reset.css --minify",
    "check:types": "pnpm build && tsc --noEmit",
    "lint": "oxlint --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepack": "pnpm build",
    "preview": "vite --host 127.0.0.1",
    "storybook": "pnpm build && storybook dev --host 127.0.0.1 --port 6008 --no-open",
    "build-storybook": "pnpm build && storybook build"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@repo/oxlint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.13.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "4.1.11",
    "happy-dom": "^21.0.1",
    "oxc-transform-react": "0.152.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-error-boundary": "^6.1.1",
    "shadcn": "4.21.5",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "catalog:",
    "vite": "^8.3.4",
    "vitest": "4.1.11",
    "@repo/storybook-config": "workspace:*",
    "@storybook/react-vite": "10.4.6",
    "storybook": "10.4.6",
    "@chromatic-com/storybook": "^5.2.1",
    "@storybook/addon-a11y": "10.4.6",
    "@storybook/addon-vitest": "10.4.6"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.57.0",
    "next-themes": "^0.4.6",
    "react-day-picker": "^10.0.2",
    "react-resizable-panels": "^4.14.5",
    "recharts": "3.8.0",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8"
  },
  "description": "The shadcn Base UI component library, packaged and maintained with compiled React components and CSS.",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/*.css",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/*.md",
    "upstream.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/styles.css"
    },
    "./styles-no-reset.css": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/styles-no-reset.css"
    }
  },
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "directory": "packages/shadcn-baseui-kit",
    "url": "git+https://github.com/AndrewCraswell/buildkit.git",
    "type": "git"
  },
  "homepage": "https://github.com/AndrewCraswell/buildkit/tree/main/packages/shadcn-baseui-kit#readme",
  "bugs": {
    "url": "https://github.com/AndrewCraswell/buildkit/issues"
  },
  "keywords": [
    "react",
    "shadcn",
    "base-ui",
    "components",
    "design-system"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
