{
  "name": "@buildkitgg/shadcn-baseui-mira",
  "version": "0.4.2",
  "description": "Upstream shadcn Base UI components in the mira style, with compiled CSS and TypeScript declarations.",
  "homepage": "https://github.com/AndrewCraswell/buildkit/tree/main/packages/shadcn/shadcn-baseui-mira#readme",
  "bugs": {
    "url": "https://github.com/AndrewCraswell/buildkit/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndrewCraswell/buildkit.git",
    "directory": "packages/shadcn/shadcn-baseui-mira"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/*.css",
    "dist/tokens.json",
    "README.md",
    "LICENSE",
    "upstream.json",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/styles.css"
    },
    "./styles-no-reset.css": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/styles-no-reset.css"
    },
    "./tokens.json": "./dist/tokens.json",
    "./theme.css": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/theme.css"
    },
    "./tailwind.css": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/tailwind.css"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node ../../tooling/shadcn-generator/src/build.mjs mira",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@buildkitgg/shadcn-runtime": "workspace:^",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.62.0",
    "next-themes": "^0.4.6",
    "react-day-picker": "^10.0.2",
    "react-resizable-panels": "^4.15.0",
    "recharts": "3.10.1",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@repo/shadcn-generator": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
