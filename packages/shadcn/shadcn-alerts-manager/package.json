{
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./dist/styles.d.ts",
      "default": "./styles.css"
    }
  },
  "name": "@buildkitgg/shadcn-alerts-manager",
  "description": "Persistent inline alerts with shared behavior and interchangeable UI adapters.",
  "license": "MIT",
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "dependencies": {
    "@buildkitgg/react-alerts": "workspace:*",
    "@buildkitgg/shadcn-baseui-kit": "workspace:*"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "styles.css",
    "README.md",
    "docs/*.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint --max-warnings=0",
    "prepack": "pnpm build",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "check:types": "pnpm build && tsc --noEmit"
  },
  "version": "0.0.0",
  "type": "module",
  "devDependencies": {
    "@repo/oxlint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^24.13.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "happy-dom": "^21.0.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "catalog:",
    "vitest": "5.0.5"
  },
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndrewCraswell/buildkit.git",
    "directory": "packages/shadcn/shadcn-alerts-manager"
  },
  "homepage": "https://github.com/AndrewCraswell/buildkit/tree/main/packages/shadcn/shadcn-alerts-manager#readme",
  "bugs": {
    "url": "https://github.com/AndrewCraswell/buildkit/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "alerts",
    "notifications",
    "typescript",
    "buildkit"
  ],
  "private": true
