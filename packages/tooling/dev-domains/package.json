{
  "name": "@buildkitgg/dev-domains",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "description": "Worktree-aware development domains built on Portless",
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "c12": "^3.3.4",
    "citty": "0.2.2",
    "cross-spawn": "^7.0.6",
    "package-manager-detector": "1.9.0",
    "portless": "0.15.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@repo/oxlint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "24.13.2",
    "@vitest/coverage-v8": "5.0.5",
    "typescript": "catalog:",
    "vitest": "5.0.5"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "dev-domains": "./dist/cli/main.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/config/schema.d.ts",
      "import": "./dist/config/schema.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./playwright": {
      "types": "./dist/playwright.d.ts",
      "import": "./dist/playwright.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AndrewCraswell/buildkit.git",
    "directory": "packages/tooling/dev-domains"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:types": "pnpm build && tsc --noEmit",
    "lint": "oxlint --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "pnpm build && vitest run --config vitest.integration.config.ts",
    "prepack": "pnpm build"
  }
}
