{
  "name": "@buildkitgg/cli",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "description": "The buildkit CLI: create, extend and upgrade Buildkit apps",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "buildkit": "./dist/bin.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AndrewCraswell/buildkit.git",
    "directory": "packages/tooling/cli"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage",
    "test:integration": "vp test run --config vitest.integration.config.ts",
    "test:smoke": "node scripts/smoke.ts",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@buildkitgg/catalog": "workspace:*",
    "@buildkitgg/scaffolder": "workspace:*",
    "citty": "0.2.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vite-plus": "catalog:"
  }
}
