{
  "name": "@buildkitgg/catalog",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "description": "Buildkit's scaffolding catalog: the TanStack Start target, the app template and its add-ons",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "templates/**",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AndrewCraswell/buildkit.git",
    "directory": "packages/tooling/catalog"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:types": "pnpm build && tsc --noEmit",
    "lint": "oxlint --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@buildkitgg/scaffolder": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@repo/oxlint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "24.13.2",
    "@vitest/coverage-v8": "5.0.5",
    "typescript": "catalog:",
    "vitest": "5.0.5"
  }
}
