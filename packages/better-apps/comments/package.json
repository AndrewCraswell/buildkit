{
  "name": "@better-apps/comments",
  "version": "0.0.0",
  "private": true,
  "description": "Comment threads on any record an app owns, optionally pinned to a spot inside it.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:types": "pnpm build && tsc --noEmit",
    "lint": "oxlint --max-warnings=0",
    "prepack": "pnpm build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@better-apps/react": "workspace:*",
    "better-apps": "workspace:*",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@better-apps/react": "workspace:*",
    "@better-apps/testing": "workspace:*",
    "@repo/oxlint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "better-apps": "workspace:*",
    "drizzle-orm": "0.45.4",
    "happy-dom": "^21.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "catalog:",
    "vitest": "5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndrewCraswell/buildkit.git",
    "directory": "packages/better-apps/comments"
  },
  "homepage": "https://github.com/AndrewCraswell/buildkit/tree/main/packages/better-apps/comments#readme",
  "bugs": {
    "url": "https://github.com/AndrewCraswell/buildkit/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "better-apps",
    "comments",
    "threads"
  ],
  "peerDependenciesMeta": {
    "@better-apps/react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
