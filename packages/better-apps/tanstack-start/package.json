{
  "name": "@better-apps/tanstack-start",
  "version": "0.0.0",
  "private": true,
  "description": "Serves Better Apps from a TanStack Start route and calls its actions from server functions as the signed-in user.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:types": "pnpm build && tsc --noEmit",
    "lint": "oxlint --max-warnings=0",
    "prepack": "pnpm build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "better-apps": "workspace:*"
  },
  "peerDependencies": {
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@better-apps/testing": "workspace:*",
    "@repo/oxlint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tanstack/react-start": "^1.169.4",
    "@tanstack/start-storage-context": "1.167.41",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "drizzle-orm": "0.45.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "catalog:",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndrewCraswell/buildkit.git",
    "directory": "packages/better-apps/tanstack-start"
  },
  "homepage": "https://github.com/AndrewCraswell/buildkit/tree/main/packages/better-apps/tanstack-start#readme",
  "bugs": {
    "url": "https://github.com/AndrewCraswell/buildkit/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "better-apps",
    "tanstack-start",
    "tanstack",
    "react"
  ]
}
