    "check:types": "pnpm build && tsc --noEmit"
  },
  "version": "0.1.1",
  "type": "module",
  "devDependencies": {
    "happy-dom": "^21.0.1",
    "@types/node": "^24.13.2",
    "@repo/typescript-config": "workspace:*",
    "@repo/oxlint-config": "workspace:*",
    "vitest": "5.0.4",
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@buildkitgg/preferences-core": "workspace:*"
  },
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndrewCraswell/buildkit.git",
    "directory": "packages/theme-core"
  },
  "homepage": "https://github.com/AndrewCraswell/buildkit/tree/main/packages/theme-core#readme",
  "bugs": {
